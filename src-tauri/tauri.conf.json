{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Pluely",
    "version":  "0.1.1",
    "identifier":  "com.srikanthnani.pluely",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "macOSPrivateApi":  true,
                "windows":  [
                                {
                                    "title":  "Pluely - AI Assistant",
                                    "width":  700,
                                    "height":  600,
                                    "decorations":  false,
                                    "transparent":  true,
                                    "alwaysOnTop":  false,
                                    "resizable":  false,
                                    "visibleOnAllWorkspaces":  true,
                                    "skipTaskbar":  true,
                                    "visible":  false,
                                    "center":  false,
                                    "contentProtected":  true,
                                    "focus":  false,
                                    "acceptFirstMouse":  true,
                                    "shadow":  false,
                                    "maximizable":  false,
                                    "minimizable":  false,
                                    "closable":  false
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "dmg",
                                   "nsis",
                                   "deb"
                               ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "resources":  [
                                     "info.plist",
                                     "pluely.desktop",
                                     "WebView2Loader.dll"
                                 ],
                   "macOS":  {
                                 "minimumSystemVersion":  "10.13"
                             },
                   "windows":  {
                                   "certificateThumbprint":  null,
                                   "digestAlgorithm":  "sha256",
                                   "timestampUrl":  "",
                                   "webviewInstallMode":  {
                                                              "type":  "downloadBootstrapper"
                                                          },
                                   "allowDowngrades":  false,
                                   "wix":  {
                                               "language":  "en-US",
                                               "template":  null,
                                               "fragmentPaths":  [

                                                                 ],
                                               "componentGroupRefs":  [

                                                                      ],
                                               "componentRefs":  [

                                                                 ],
                                               "featureGroupRefs":  [

                                                                    ],
                                               "featureRefs":  [

                                                               ],
                                               "mergeRefs":  [

                                                             ]
                                           },
                                   "nsis":  {
                                                "template":  null,
                                                "languages":  [
                                                                  "English"
                                                              ],
                                                "customLanguageFiles":  {

                                                                        },
                                                "displayLanguageSelector":  false
                                            }
                               },
                   "linux":  {
                                 "deb":  {
                                             "depends":  [
                                                             "libasound2-dev",
                                                             "libpulse-dev",
                                                             "libwebkit2gtk-4.0-37",
                                                             "libgtk-3-0",
                                                             "libayatana-appindicator3-1"
                                                         ],
                                             "desktopTemplate":  "pluely.desktop"
                                         }
                             }
               },
    "plugins":  {
                    "updater":  {
                                    "endpoints":  [
                                                      "https://api.github.com/repos/iamsrikanthnani/pluely/releases/latest"
                                                  ],
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkgNjUyQzc5Mzk5OTEzNzM5Nw0KUldTWGN4T1pPWGtzWlJjS0lqVlordW9YbTZ3c01HQmRHdFJnRjRwZmtxYUNtRDFEdnM5ZkxMYUQNCg=="
                                }
                }
}
