{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pluely.app/schemas/structured-ai-response.json",
  "title": "StructuredAIResponse",
  "type": "object",
  "required": ["version","responseId","responseType","questionEcho","interviewTone","meta","answer"],
  "properties": {
    "version": {"type": "string"},
    "responseId": {"type": "string"},
    "responseType": {"type": "string", "enum": ["theoretical","coding","mcq"]},
    "questionEcho": {"type": "string"},
    "interviewTone": {"type": "boolean"},
    "meta": {
      "type": "object",
      "required": ["confidence","difficulty","tags"],
      "properties": {
        "confidence": {"type":"number","minimum":0,"maximum":1},
        "difficulty": {"type":"string","enum":["easy","medium","hard"]},
        "tags": {"type":"array","items":{"type":"string"}}
      },
      "additionalProperties": false
    },
    "answer": {"type":"object"},
    "followUps": {
      "type":"array",
      "items": {
        "type":"object",
        "required":["prompt","purpose"],
        "properties": {
          "prompt": {"type":"string"},
          "purpose": {"type":"string"}
        },
        "additionalProperties": false
      },
      "maxItems": 3
    }
  },
  "allOf": [
    {
      "if": {"properties": {"responseType": {"const": "theoretical"}}},
      "then": {
        "properties": {
          "answer": {
            "type": "object",
            "required": ["summary","detailed","keyPoints","pitfalls"],
            "properties": {
              "summary": {"type":"string"},
              "detailed": {"type":"string"},
              "keyPoints": {"type":"array","items":{"type":"string"}},
              "pitfalls": {"type":"array","items":{"type":"string"}}
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {"properties": {"responseType": {"const": "coding"}}},
      "then": {
        "properties": {
          "answer": {
            "type": "object",
            "required": ["solutionOverview","approachSteps","timeComplexity","spaceComplexity","constraints","code"],
            "properties": {
              "solutionOverview": {"type":"string"},
              "approachSteps": {"type":"array","items":{"type":"string"}},
              "timeComplexity": {"type":"string"},
              "spaceComplexity": {"type":"string"},
              "constraints": {
                "type": "object",
                "required": ["inputSizes","edgeCases","assumptions"],
                "properties": {
                  "inputSizes": {"type":"string"},
                  "valueRanges": {"type":"string"},
                  "edgeCases": {"type":"array","items":{"type":"string"}},
                  "assumptions": {"type":"array","items":{"type":"string"}}
                },
                "additionalProperties": false
              },
              "variants": {"type":"array","items":{"type":"string"}},
              "code": {
                "type":"object",
                "required":["language","style","main"],
                "properties": {
                  "language": {"type":"string"},
                  "style": {"type":"string"},
                  "main": {"type":"string"},
                  "helperSnippets": {"type":"array","items":{"type":"object","required":["name","code"],"properties":{"name":{"type":"string"},"code":{"type":"string"}},"additionalProperties": false}}
                },
                "additionalProperties": false
              },
              "tests": {"type":"array","items":{"type":"object","required":["input","expected"],"properties":{"input":{"type":"string"},"expected":{"type":"string"}},"additionalProperties": false}},
              "explanationNotes": {"type":"array","items":{"type":"string"}}
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {"properties": {"responseType": {"const": "mcq"}}},
      "then": {
        "properties": {
          "answer": {
            "type": "object",
            "required": ["question","options","correctOptionId","justification"],
            "properties": {
              "question": {"type":"string"},
              "options": {"type":"array","minItems":2,"items":{"type":"object","required":["id","text"],"properties":{"id":{"type":"string"},"text":{"type":"string"}},"additionalProperties": false}},
              "correctOptionId": {"type":"string"},
              "justification": {"type":"string"},
              "eliminations": {"type":"array","items":{"type":"object","required":["optionId","reason"],"properties":{"optionId":{"type":"string"},"reason":{"type":"string"}},"additionalProperties": false}},
              "quickRecallHook": {"type":"string"}
            },
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "additionalProperties": false
}